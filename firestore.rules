rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn(){return request.auth!=null;}
  function hasProfile(uid){return exists(/databases/$(database)/documents/users/$(uid));}
  function profile(uid){return get(/databases/$(database)/documents/users/$(uid)).data;}
  // Backward-compatible for existing accounts created before the active flag was introduced; explicitly blocked accounts remain denied.
  function active(){return signedIn()&&hasProfile(request.auth.uid)&&profile(request.auth.uid).active!=false;}
  function worker(){return active()&&profile(request.auth.uid).role=='worker';}
  function company(){return active()&&profile(request.auth.uid).role=='company';}
  function admin(){return active()&&profile(request.auth.uid).role=='admin'&&profile(request.auth.uid).adminLevel=='super';}
  function staffAdmin(){return active()&&profile(request.auth.uid).role=='admin'&&profile(request.auth.uid).adminLevel=='staff';}
  function staffCan(permission){return staffAdmin()&&profile(request.auth.uid).permissions is list&&profile(request.auth.uid).permissions.hasAny([permission]);}
  match /users/{uid}{
   allow create:if signedIn()&&request.auth.uid==uid&&request.resource.data.role in ['worker','company','customer']&&request.resource.data.active==true&&request.resource.data.email is string&&request.resource.data.name is string;
   allow read:if signedIn()&&(request.auth.uid==uid||admin()||staffCan('users'));
   allow update:if signedIn()&&request.auth.uid==uid&&request.resource.data.role==resource.data.role&&request.resource.data.active==resource.data.active&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','mobile','city','photoURL','skills','experience','about','preference','state','phone','email','updatedAt','mainSkill','secondSkill','dailyWage','hourlyRate','workingDays','workingTime','workRange','availability','age','gender','area','pincode','address','emergencyContact','aadhaarLast4','notificationsEnabled','soundEnabled','hidePhone','language','fcmToken','fcmTokens','fcmTokenUpdatedAt']);
   allow update:if admin()&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active','updatedAt']);
   allow delete:if admin();
  }
  match /workerPublicProfiles/{uid}{
   allow read:if active();
   allow create,update:if worker()&&request.auth.uid==uid&&request.resource.data.userId==request.auth.uid&&request.resource.data.keys().hasOnly(['userId','name','photoURL','city','area','pincode','mainSkill','secondSkill','skills','experience','dailyWage','hourlyRate','workingDays','workingTime','workRange','availability','updatedAt','rating','lat','lng','accuracy','lastSeen']);
   allow delete:if worker()&&request.auth.uid==uid||admin();
  }
  match /jobs/{id}{
   allow read:if active()||admin()||staffCan('jobs');
   allow create:if company()&&request.resource.data.ownerId==request.auth.uid&&request.resource.data.status=='published'&&request.resource.data.approvalRequired==false&&request.resource.data.title is string&&request.resource.data.title.size()>0&&request.resource.data.title.size()<=120&&request.resource.data.city is string;
   allow update:if (company()&&resource.data.ownerId==request.auth.uid&&request.resource.data.ownerId==resource.data.ownerId&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title','company','city','state','type','pay','skills','desc','details','updatedAt'])&&request.resource.data.status==resource.data.status)||(company()&&resource.data.ownerId==request.auth.uid&&request.resource.data.ownerId==resource.data.ownerId&&request.resource.data.status=='paused'&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt']))||(admin()&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt']));
   allow delete:if (company()&&resource.data.ownerId==request.auth.uid)||admin();
  }
  match /applications/{id}{
   allow create:if worker()&&request.resource.data.workerId==request.auth.uid&&request.resource.data.status in ['Applied','applied']&&request.resource.data.title is string;
   allow read:if admin()||staffCan('applications')||(worker()&&resource.data.workerId==request.auth.uid)||(company()&&resource.data.employerId==request.auth.uid);
   allow update:if company()&&resource.data.employerId==request.auth.uid&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt'])&&request.resource.data.status in ['Shortlisted','Rejected','Accepted','Completed','applied'];
   allow delete:if admin();
  }
  match /workerBookings/{id}{
   allow create:if (company()&&request.resource.data.companyId==request.auth.uid&&request.resource.data.status=='Pending'&&request.resource.data.category is string&&request.resource.data.count is int&&request.resource.data.count>=1&&request.resource.data.count<=500&&request.resource.data.bookingType in ['Hourly','Daily','Monthly']&&(request.resource.data.bookingType!='Monthly'||(request.resource.data.durationMonths is int&&request.resource.data.durationMonths>=1&&request.resource.data.durationMonths<=24)))||(active()&&profile(request.auth.uid).role=='customer'&&request.resource.data.requesterId==request.auth.uid&&request.resource.data.requesterRole=='customer'&&request.resource.data.status=='Pending'&&request.resource.data.category is string&&request.resource.data.count is int&&request.resource.data.count>=1&&request.resource.data.count<=50&&request.resource.data.bookingType in ['Hourly','Daily']);
   allow read:if admin()||staffCan('users')||(company()&&resource.data.companyId==request.auth.uid)||(active()&&profile(request.auth.uid).role=='customer'&&resource.data.requesterId==request.auth.uid)||(worker()&&(resource.data.status in ['Pending','Partially Filled']||resource.data.workerId==request.auth.uid||(resource.data.acceptedWorkerIds is list&&resource.data.acceptedWorkerIds.hasAny([request.auth.uid]))));
    allow update:if admin()||(company()&&resource.data.companyId==request.auth.uid&&request.resource.data.companyId==resource.data.companyId&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt'])&&request.resource.data.status in ['Confirmed','Rejected','Completed'])||(signedIn()&&profile(request.auth.uid).role=='worker'&&(resource.data.selectedWorkerId==null||resource.data.selectedWorkerId==''||resource.data.selectedWorkerId==request.auth.uid)&&resource.data.status in ['Pending','Partially Filled']&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['count','acceptedWorkerIds','acceptedWorkers','acceptedCount','workerId','workerName','status','acceptedAt','confirmedAt','updatedAt','confirmationMode'])&&request.resource.data.acceptedWorkerIds is list&&request.resource.data.acceptedWorkerIds.hasAny([request.auth.uid])&&request.resource.data.acceptedCount==request.resource.data.acceptedWorkerIds.size()&&request.resource.data.count is int&&request.resource.data.acceptedCount<=request.resource.data.count&&request.resource.data.workerId==request.resource.data.acceptedWorkerIds[0]&&((request.resource.data.acceptedCount==request.resource.data.count&&request.resource.data.status=='Confirmed')||(request.resource.data.acceptedCount<request.resource.data.count&&request.resource.data.status=='Partially Filled')))||(active()&&profile(request.auth.uid).role=='customer'&&resource.data.requesterId==request.auth.uid&&request.resource.data.requesterId==resource.data.requesterId&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','date','shift','details','updatedAt'])&&((request.resource.data.status=='Cancelled'&&resource.data.status in ['Pending','Partially Filled'])||(request.resource.data.status==resource.data.status&&resource.data.status in ['Pending','Partially Filled'])));
   allow delete:if admin()||(company()&&resource.data.companyId==request.auth.uid);
  }
  match /workerActiveBookings/{workerId}{
   allow create,update:if worker()&&request.auth.uid==workerId&&request.resource.data.workerId==request.auth.uid&&request.resource.data.bookingId is string;
   allow read:if signedIn()&&request.auth.uid==workerId||admin();
   allow delete:if admin()||(company()&&get(/databases/$(database)/documents/workerBookings/$(resource.data.bookingId)).data.companyId==request.auth.uid&&get(/databases/$(database)/documents/workerBookings/$(resource.data.bookingId)).data.status in ['Completed','Rejected']);
  }
  match /notifications/{id}{
   allow create:if active()&&request.resource.data.actorId==request.auth.uid&&request.resource.data.recipientId is string&&request.resource.data.recipientId!=request.auth.uid&&request.resource.data.title is string&&request.resource.data.message is string&&request.resource.data.message.size()<=500;
   allow read,update,delete:if active()&&resource.data.recipientId==request.auth.uid;
  }
  match /workerBookings/{bookingId}/tracking/{workerId}{
   function booking(){return get(/databases/$(database)/documents/workerBookings/$(bookingId)).data;}
   function assigned(){return booking().acceptedWorkerIds is list&&booking().acceptedWorkerIds.hasAny([request.auth.uid])||booking().workerId==request.auth.uid;}
   allow create,update:if worker()&&request.auth.uid==workerId&&assigned()&&request.resource.data.workerId==request.auth.uid&&request.resource.data.sharing==true&&request.resource.data.lat is number&&request.resource.data.lng is number;
   allow read:if admin()||staffCan('users')||(active()&&profile(request.auth.uid).role=='customer'&&booking().requesterId==request.auth.uid)||(company()&&booking().companyId==request.auth.uid)||(worker()&&assigned());
   allow delete:if admin()||(worker()&&request.auth.uid==workerId);
  }
  match /locations/{uid}{
   allow create,update:if (worker()||company())&&request.auth.uid==uid&&request.resource.data.uid==request.auth.uid&&request.resource.data.role==profile(request.auth.uid).role&&request.resource.data.sharing==true&&request.resource.data.lat is number&&request.resource.data.lng is number;
   allow read:if admin()||company()||(staffCan('users'))||(worker()&&resource.data.role=='company')||(worker()&&request.auth.uid==uid);
   allow delete:if admin()||(active()&&request.auth.uid==uid);
  }
  match /conversations/{conversationId}{
   function isParticipant(){return signedIn()&&resource.data.participants is list&&resource.data.participants.hasAny([request.auth.uid]);}
   allow create:if signedIn()&&request.resource.data.participants is list&&request.resource.data.participants.size()==2&&request.resource.data.participants.hasAny([request.auth.uid])&&request.resource.data.createdBy==request.auth.uid;
   allow read:if isParticipant();
   allow update:if isParticipant()&&request.resource.data.participants==resource.data.participants&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage','updatedAt','names']);
   allow delete:if false;
   match /messages/{messageId}{
    function parentConversation(){return get(/databases/$(database)/documents/conversations/$(conversationId)).data;}
    function participant(){return signedIn()&&parentConversation().participants is list&&parentConversation().participants.hasAny([request.auth.uid]);}
    allow read:if participant();
    allow create:if participant()&&request.resource.data.senderId==request.auth.uid&&request.resource.data.text is string&&request.resource.data.text.size()>0&&request.resource.data.text.size()<=2000&&!request.resource.data.text.matches('.*[6-9][0-9]{4}[ -]?[0-9]{5}.*');
    allow update,delete:if false;
   }
  }

  match /workerSupportTickets/{ticketId}{
   allow create:if ((worker()||active()&&profile(request.auth.uid).role=='customer')&&request.resource.data.workerId==request.auth.uid&&request.resource.data.type is string&&request.resource.data.message is string&&request.resource.data.message.size()>0&&request.resource.data.message.size()<=1500&&request.resource.data.status=='Open');
   allow read:if ((worker()||active()&&profile(request.auth.uid).role=='customer')&&resource.data.workerId==request.auth.uid)||admin()||staffCan('users');
   allow update,delete:if admin()||staffCan('users');
  }
  match /workerReviews/{reviewId}{
   allow read:if worker()&&resource.data.workerId==request.auth.uid;
   allow create:if active()&&profile(request.auth.uid).role=='customer'&&request.resource.data.customerId==request.auth.uid&&request.resource.data.workerId is string&&request.resource.data.rating is number&&request.resource.data.rating>=1&&request.resource.data.rating<=5&&request.resource.data.bookingId is string;
   allow update,delete:if false;
  }

  // HireHub protection data: client writes are restricted; trusted Cloud Functions own state transitions.
  function bookingParticipant(bookingId) {
    let b = get(/databases/$(database)/documents/workerBookings/$(bookingId)).data;
    return active() && (
      b.requesterId == request.auth.uid ||
      b.customerId == request.auth.uid ||
      b.companyId == request.auth.uid ||
      b.workerId == request.auth.uid ||
      (b.acceptedWorkerIds is list && b.acceptedWorkerIds.hasAny([request.auth.uid]))
    );
  }
  match /bookingPayments/{bookingId} {
    allow read: if admin() || staffCan('payments') || bookingParticipant(bookingId);
    allow create, update, delete: if false;
  }
  match /bookingProtection/{bookingId} {
    allow read, write: if false;
  }
  match /bookingAgreements/{agreementId} {
    allow read: if admin() || (signedIn() && resource.data.workerId == request.auth.uid);
    allow create, update, delete: if false;
  }
  match /workerRewards/{workerId} {
    allow read: if admin() || (worker() && request.auth.uid == workerId);
    allow create, update, delete: if false;
  }
  match /bookingRiskFlags/{flagId} {
    allow read: if admin() || staffCan('payments');
    allow update: if (admin() || staffCan('payments')) &&
      request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','reviewedBy','reviewedAt']);
    allow create, delete: if false;
  }
  match /workerBookings/{bookingId}/checkins/{workerId} {
    allow read: if admin() || bookingParticipant(bookingId);
    allow create, update, delete: if false;
  }

  match /{document=**}{allow read,write:if false;}
 }
}
// Deploy trigger: Firestore-only deployment path; validation adjusted for modular worker app.
