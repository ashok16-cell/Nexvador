rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function profile(uid) { return get(/databases/$(database)/documents/users/$(uid)).data; }
    function active() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && profile(request.auth.uid).active == true;
    }
    function worker() { return active() && profile(request.auth.uid).role == 'worker'; }
    function company() { return active() && profile(request.auth.uid).role == 'company'; }
    function admin() { return active() && profile(request.auth.uid).role == 'admin'; }

    match /users/{uid} {
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.role in ['worker', 'company']
        && request.resource.data.active == true;
      allow read: if signedIn() && (request.auth.uid == uid || admin());
      allow update: if (signedIn() && request.auth.uid == uid
        && request.resource.data.role == resource.data.role
        && request.resource.data.active == resource.data.active)
        || (admin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active','updatedAt']));
      allow delete: if admin();
    }

    match /jobs/{jobId} {
      allow read: if (active() && resource.data.status == 'published')
        || (company() && resource.data.ownerId == request.auth.uid) || admin();
      allow create: if company() && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.status == 'published';
      allow update: if (company() && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['title','company','city','state','type','pay','skills','desc','status','updatedAt']))
        || (admin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt']));
      allow delete: if (company() && resource.data.ownerId == request.auth.uid) || admin();
    }

    match /applications/{id} {
      allow create: if worker() && request.resource.data.workerId == request.auth.uid
        && request.resource.data.status == 'applied';
      allow read: if admin()
        || (worker() && resource.data.workerId == request.auth.uid)
        || (company() && resource.data.employerId == request.auth.uid);
      allow update: if company() && resource.data.employerId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt'])
        && request.resource.data.status in ['Shortlisted','Rejected','Accepted','Completed'];
      allow delete: if admin();
    }

    match /workerBookings/{id} {
      allow create: if worker() && request.resource.data.workerId == request.auth.uid
        && request.resource.data.status == 'Pending';
      allow read: if admin() || (worker() && resource.data.workerId == request.auth.uid);
      allow update, delete: if admin();
    }

    match /locations/{uid} {
      allow create, update: if active() && request.auth.uid == uid
        && request.resource.data.uid == request.auth.uid;
      allow read: if admin();
      allow delete: if admin() || (signedIn() && request.auth.uid == uid);
    }

    match /{document=**} { allow read, write: if false; }
  }
}