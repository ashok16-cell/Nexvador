rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn(){return request.auth!=null;}
  function hasProfile(uid){return exists(/databases/$(database)/documents/users/$(uid));}
  function profile(uid){return get(/databases/$(database)/documents/users/$(uid)).data;}
  // Backward-compatible for existing accounts created before the active flag was introduced; explicitly blocked accounts remain denied.
  function active(){return signedIn()&&hasProfile(request.auth.uid)&&(!('active' in profile(request.auth.uid))||profile(request.auth.uid).active==true);}
  function worker(){return active()&&profile(request.auth.uid).role=='worker';}
  function company(){return active()&&profile(request.auth.uid).role=='company';}
  function admin(){return active()&&profile(request.auth.uid).role=='admin'&&profile(request.auth.uid).adminLevel=='super';}
  function staffAdmin(){return active()&&profile(request.auth.uid).role=='admin'&&profile(request.auth.uid).adminLevel=='staff';}
  function staffCan(permission){return staffAdmin()&&profile(request.auth.uid).permissions is list&&profile(request.auth.uid).permissions.hasAny([permission]);}
  match /users/{uid}{
   allow create:if signedIn()&&request.auth.uid==uid&&request.resource.data.role in ['worker','company','customer']&&request.resource.data.active==true&&request.resource.data.email is string&&request.resource.data.name is string;
   allow read:if signedIn()&&(request.auth.uid==uid||admin()||staffCan('users'));
   allow update:if signedIn()&&request.auth.uid==uid&&request.resource.data.role==resource.data.role&&((!('active' in resource.data)&&!('active' in request.resource.data))||('active' in resource.data&&request.resource.data.active==resource.data.active))&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','mobile','city','photoURL','skills','experience','about','preference','state','phone','email','updatedAt','mainSkill','secondSkill','dailyWage','hourlyRate','upiId','workingDays','workingTime','workRange','availability','age','gender','area','pincode','address','emergencyContact','aadhaarLast4','notificationsEnabled','soundEnabled','hidePhone','language','fcmToken','fcmTokens','fcmTokenUpdatedAt','autoOnline']);
   allow update:if admin()&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active','updatedAt']);
   allow delete:if admin();
  }
  match /workerPublicProfiles/{uid}{
   allow read:if active();
   allow create,update:if worker()&&request.auth.uid==uid&&request.resource.data.userId==request.auth.uid&&request.resource.data.keys().hasOnly(['userId','name','photoURL','state','city','area','pincode','mainSkill','secondSkill','skills','experience','dailyWage','hourlyRate','upiId','workingDays','workingTime','workRange','availability','updatedAt','rating','lat','lng','accuracy','lastSeen']);
   allow delete:if worker()&&request.auth.uid==uid||admin();
  }
  match /jobs/{id}{
   allow read:if active()||admin()||staffCan('jobs');
   allow create:if company()&&request.resource.data.ownerId==request.auth.uid&&request.resource.data.status=='published'&&request.resource.data.approvalRequired==false&&request.resource.data.title is string&&request.resource.data.title.size()>0&&request.resource.data.title.size()<=120&&request.resource.data.city is string;
   allow update:if (company()&&resource.data.ownerId==request.auth.uid&&request.resource.data.ownerId==resource.data.ownerId&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title','company','city','state','type','pay','skills','desc','details','updatedAt'])&&request.resource.data.status==resource.data.status)||(company()&&resource.data.ownerId==request.auth.uid&&request.resource.data.ownerId==resource.data.ownerId&&request.resource.data.status=='paused'&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt']))||(admin()&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt']));
   allow delete:if (company()&&resource.data.ownerId==request.auth.uid)||admin();
  }
  match /applications/{id}{
   allow create:if worker()&&request.resource.data.workerId==request.auth.uid&&request.resource.data.status in ['Applied','applied']&&request.resource.data.title is string;
   allow read:if admin()||staffCan('applications')||(worker()&&resource.data.workerId==request.auth.uid)||(company()&&resource.data.employerId==request.auth.uid);
   allow update:if company()&&resource.data.employerId==request.auth.uid&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt'])&&request.resource.data.status in ['Shortlisted','Rejected','Accepted','Completed','applied'];
   allow delete:if admin();
  }
    match /workerPaymentSubmissions/{paymentId}{
   allow create:if active()&&profile(request.auth.uid).role=='customer'&&request.resource.data.customerId==request.auth.uid&&request.resource.data.bookingId is string&&request.resource.data.workerId is string&&request.resource.data.amount is number&&request.resource.data.amount>0&&request.resource.data.amount<=10000000&&request.resource.data.utr is string&&request.resource.data.utr.size()>=6&&request.resource.data.utr.size()<=80&&request.resource.data.status=='submitted'&&get(/databases/$(database)/documents/workerBookings/$(request.resource.data.bookingId)).data.requesterId==request.auth.uid&&((get(/databases/$(database)/documents/workerBookings/$(request.resource.data.bookingId)).data.workerId==request.resource.data.workerId)||(get(/databases/$(database)/documents/workerBookings/$(request.resource.data.bookingId)).data.acceptedWorkerIds is list&&get(/databases/$(database)/documents/workerBookings/$(request.resource.data.bookingId)).data.acceptedWorkerIds.hasAny([request.resource.data.workerId])));
   allow read:if admin()||(active()&&(resource.data.customerId==request.auth.uid||resource.data.workerId==request.auth.uid));
   allow update:if admin()&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','adminNote','verifiedAt','verifiedBy'])&&request.resource.data.status in ['verified','rejected'];
   allow delete:if admin();
  }
match /workerBookings/{id}{
   allow create:if (company()&&request.resource.data.companyId==request.auth.uid&&request.resource.data.status=='Pending'&&request.resource.data.category is string&&request.resource.data.count is int&&request.resource.data.count>=1&&request.resource.data.count<=500&&request.resource.data.bookingType in ['Hourly','Daily','Monthly']&&(request.resource.data.bookingType!='Monthly'||(request.resource.data.durationMonths is int&&request.resource.data.durationMonths>=1&&request.resource.data.durationMonths<=24)))||(active()&&profile(request.auth.uid).role=='customer'&&request.resource.data.requesterId==request.auth.uid&&request.resource.data.requesterRole=='customer'&&request.resource.data.status=='Pending'&&request.resource.data.category is string&&request.resource.data.count is int&&request.resource.data.count>=1&&request.resource.data.count<=50&&request.resource.data.bookingType in ['Hourly','Daily']);
   allow read:if admin()||staffCan('users')||(company()&&resource.data.companyId==request.auth.uid)||(active()&&profile(request.auth.uid).role=='customer'&&resource.data.requesterId==request.auth.uid)||(worker()&&(resource.data.status in ['Pending','Partially Filled']||resource.data.workerId==request.auth.uid||(resource.data.acceptedWorkerIds is list&&resource.data.acceptedWorkerIds.hasAny([request.auth.uid]))||(exists(/databases/$(database)/documents/workerActiveBookings/$(request.auth.uid))&&get(/databases/$(database)/documents/workerActiveBookings/$(request.auth.uid)).data.bookingId==id)));
    allow update:if admin()||(company()&&resource.data.companyId==request.auth.uid&&request.resource.data.companyId==resource.data.companyId&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt'])&&request.resource.data.status in ['Confirmed','Rejected','Completed'])||(worker()&&(resource.data.acceptedWorkerIds is list&&resource.data.acceptedWorkerIds.hasAny([request.auth.uid])||resource.data.workerId==request.auth.uid)&&resource.data.status in ['Confirmed','Partially Filled']&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['workerCompletionStatus','workerCompletedAt','workerCompletedBy','superAdminCompletionNoticeStatus','superAdminCompletionNoticeAt','superAdminCompletionNoticeBy','updatedAt'])&&request.resource.data.workerCompletionStatus=='submitted'&&request.resource.data.workerCompletedBy==request.auth.uid&&request.resource.data.workerCompletedAt==request.time&&request.resource.data.updatedAt==request.time)||(worker()&&(!('selectedWorkerId' in resource.data)||resource.data.selectedWorkerId==null||resource.data.selectedWorkerId==''||resource.data.selectedWorkerId==request.auth.uid)&&resource.data.status in ['Pending','Partially Filled']&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['count','acceptedWorkerIds','acceptedWorkers','acceptedCount','workerId','workerName','status','acceptedAt','confirmedAt','updatedAt','confirmationMode'])&&request.resource.data.acceptedWorkerIds is list&&request.resource.data.acceptedWorkerIds.hasAny([request.auth.uid])&&request.resource.data.acceptedCount==request.resource.data.acceptedWorkerIds.size()&&request.resource.data.count is int&&request.resource.data.acceptedCount<=request.resource.data.count&&request.resource.data.workerId==request.resource.data.acceptedWorkerIds[0]&&((request.resource.data.acceptedCount==request.resource.data.count&&request.resource.data.status=='Confirmed')||(request.resource.data.acceptedCount<request.resource.data.count&&request.resource.data.status=='Partially Filled')))||(active()&&profile(request.auth.uid).role=='customer'&&resource.data.requesterId==request.auth.uid&&request.resource.data.requesterId==resource.data.requesterId&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','date','shift','details','cancellationReason','cancelledAt','cancellationRisk','cancellationRiskReason','updatedAt'])&&((request.resource.data.status=='Cancelled'&&resource.data.status in ['Pending','Partially Filled','Confirmed'])||(request.resource.data.status==resource.data.status&&resource.data.status in ['Pending','Partially Filled'])));
   allow delete:if admin()||(company()&&resource.data.companyId==request.auth.uid);
  }
  match /workerActiveBookings/{workerId}{
   allow create,update:if worker()&&request.auth.uid==workerId&&request.resource.data.workerId==request.auth.uid&&request.resource.data.bookingId is string;
   allow read:if signedIn()&&request.auth.uid==workerId||admin();
   allow delete:if admin()||(company()&&get(/databases/$(database)/documents/workerBookings/$(resource.data.bookingId)).data.companyId==request.auth.uid&&get(/databases/$(database)/documents/workerBookings/$(resource.data.bookingId)).data.status in ['Completed','Rejected']);
  }
  match /notifications/{id}{
   allow create:if active()&&request.resource.data.actorId==request.auth.uid&&request.resource.data.recipientId is string&&request.resource.data.recipientId!=request.auth.uid&&request.resource.data.title is string&&request.resource.data.message is string&&request.resource.data.message.size()<=500&&((request.resource.data.recipientId!='__admins__')||(worker()&&request.resource.data.audience=='admins'&&request.resource.data.eventType=='worker_completion_submitted'&&request.resource.data.bookingId is string)||(profile(request.auth.uid).role=='customer'&&request.resource.data.audience=='admins'&&request.resource.data.eventType=='customer_upi_payment_submitted'&&request.resource.data.bookingId is string&&request.resource.data.paymentSubmissionId is string));
   allow read:if active()&&(resource.data.recipientId==request.auth.uid||(profile(request.auth.uid).role=='admin'&&resource.data.audience=='admins'));
   allow update:if active()&&((resource.data.recipientId==request.auth.uid&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read','updatedAt']))||(profile(request.auth.uid).role=='admin'&&resource.data.audience=='admins'&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy','updatedAt'])&&request.resource.data.readBy is list&&request.resource.data.readBy.hasAny([request.auth.uid])));
   allow delete:if active()&&resource.data.recipientId==request.auth.uid;
  }
  match /workerBookings/{bookingId}/tracking/{workerId}{
   function booking(){return get(/databases/$(database)/documents/workerBookings/$(bookingId)).data;}
   function assigned(){return booking().acceptedWorkerIds is list&&booking().acceptedWorkerIds.hasAny([request.auth.uid])||booking().workerId==request.auth.uid;}
   allow create,update:if worker()&&request.auth.uid==workerId&&assigned()&&request.resource.data.workerId==request.auth.uid&&request.resource.data.sharing==true&&request.resource.data.lat is number&&request.resource.data.lng is number;
   allow read:if admin()||staffCan('users')||(active()&&profile(request.auth.uid).role=='customer'&&booking().requesterId==request.auth.uid)||(company()&&booking().companyId==request.auth.uid)||(worker()&&assigned());
   allow delete:if admin()||(worker()&&request.auth.uid==workerId);
  }
  match /locations/{uid}{
   function validCoordinates(){return request.resource.data.lat is number&&request.resource.data.lat>=-90&&request.resource.data.lat<=90&&request.resource.data.lng is number&&request.resource.data.lng>=-180&&request.resource.data.lng<=180;}
   function linkedBooking(){return exists(/databases/$(database)/documents/workerActiveBookings/$(uid))&&get(/databases/$(database)/documents/workerActiveBookings/$(uid)).data.bookingId is string&&exists(/databases/$(database)/documents/workerBookings/$(get(/databases/$(database)/documents/workerActiveBookings/$(uid)).data.bookingId));}
   function bookingData(){return get(/databases/$(database)/documents/workerBookings/$(get(/databases/$(database)/documents/workerActiveBookings/$(uid)).data.bookingId)).data;}
   function assignedCompany(){return linkedBooking()&&company()&&bookingData().companyId==request.auth.uid&&bookingData().status in ['Confirmed','Partially Filled'];}
   function assignedCustomer(){return linkedBooking()&&active()&&profile(request.auth.uid).role=='customer'&&bookingData().requesterId==request.auth.uid&&bookingData().status in ['Confirmed','Partially Filled'];}
   allow create,update:if (worker()||company())&&request.auth.uid==uid&&request.resource.data.uid==request.auth.uid&&request.resource.data.role==profile(request.auth.uid).role&&request.resource.data.sharing==true&&validCoordinates();
   // GPS is visible only to the owner, administrators, or the company/customer on the worker's active booking.
   allow read:if admin()||staffCan('users')||(worker()&&request.auth.uid==uid)||assignedCompany()||assignedCustomer();
   allow delete:if admin()||(active()&&request.auth.uid==uid);
  }
  match /conversations/{conversationId}{
   function bookingDoc(bookingId){return get(/databases/$(database)/documents/workerBookings/$(bookingId)).data;}
   function bookingIsConfirmed(bookingId,participants){
    let b=bookingDoc(bookingId);
    let requester=('requesterId' in b&&b.requesterId is string)?b.requesterId:b.companyId;
    let workers=('acceptedWorkerIds' in b&&b.acceptedWorkerIds is list)?b.acceptedWorkerIds:(('workerId' in b&&b.workerId is string)?[b.workerId]:[]);
    return b.status=='Confirmed'&&participants is list&&participants.size()==2&&participants.hasAny([requester])&&participants.hasAny(workers);
   }
   function isBookingParticipant(){
    return signedIn()&&resource.data.bookingId is string&&resource.data.participants is list&&resource.data.participants.hasAny([request.auth.uid])&&bookingIsConfirmed(resource.data.bookingId,resource.data.participants);
   }
   allow create:if signedIn()&&request.resource.data.bookingId is string&&request.resource.data.participants is list&&request.resource.data.participants.hasAny([request.auth.uid])&&request.resource.data.createdBy==request.auth.uid&&bookingIsConfirmed(request.resource.data.bookingId,request.resource.data.participants);
   allow read:if isBookingParticipant();
   allow update:if isBookingParticipant()&&request.resource.data.bookingId==resource.data.bookingId&&request.resource.data.participants==resource.data.participants&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage','updatedAt','names']);
   allow delete:if false;
   match /messages/{messageId}{
    function parent(){return get(/databases/$(database)/documents/conversations/$(conversationId)).data;}
    function participant(){return signedIn()&&parent().bookingId is string&&parent().participants is list&&parent().participants.hasAny([request.auth.uid])&&bookingIsConfirmed(parent().bookingId,parent().participants);}
    allow read:if participant();
    allow create:if participant()&&request.resource.data.senderId==request.auth.uid&&request.resource.data.text is string&&request.resource.data.text.size()>0&&request.resource.data.text.size()<=2000;
    allow update,delete:if false;
   }
   match /calls/{callId}{
    function parent(){return get(/databases/$(database)/documents/conversations/$(conversationId)).data;}
    function callParticipant(){return signedIn()&&parent().bookingId is string&&parent().participants is list&&parent().participants.hasAny([request.auth.uid])&&bookingIsConfirmed(parent().bookingId,parent().participants);}
    allow create:if callParticipant()&&request.resource.data.bookingId==parent().bookingId&&request.resource.data.callerId==request.auth.uid&&parent().participants.hasAny([request.resource.data.calleeId])&&request.resource.data.status=='ringing'&&request.resource.data.offer.sdp is string;
    allow read:if callParticipant();
    allow update:if callParticipant()&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['answer','status','answeredAt','endedAt'])&&((request.auth.uid==resource.data.calleeId&&request.resource.data.status=='answered')||(request.auth.uid in [resource.data.callerId,resource.data.calleeId]&&request.resource.data.status=='ended'));
    allow delete:if false;
    match /{candidateCollection}/{candidateId}{
     function callDoc(){return get(/databases/$(database)/documents/conversations/$(conversationId)/calls/$(callId)).data;}
     function callMember(){return signedIn()&&candidateCollection in ['callerCandidates','calleeCandidates']&&request.auth.uid in [callDoc().callerId,callDoc().calleeId]&&parent().participants.hasAny([request.auth.uid])&&bookingIsConfirmed(parent().bookingId,parent().participants);}
     allow read:if callMember();
     allow create:if callMember()&&request.resource.data.keys().hasOnly(['candidate','sdpMid','sdpMLineIndex','usernameFragment']);
     allow update,delete:if false;
    }
   }
  }

  match /workerSupportTickets/{ticketId}{
   allow create:if ((worker()||active()&&profile(request.auth.uid).role=='customer')&&request.resource.data.workerId==request.auth.uid&&request.resource.data.type is string&&request.resource.data.message is string&&request.resource.data.message.size()>0&&request.resource.data.message.size()<=1500&&request.resource.data.status=='Open');
   allow read:if ((worker()||active()&&profile(request.auth.uid).role=='customer')&&resource.data.workerId==request.auth.uid)||admin()||staffCan('users');
   allow update,delete:if admin()||staffCan('users');
  }
  match /workerReviews/{reviewId}{
   allow read:if worker()&&resource.data.workerId==request.auth.uid;
   allow create:if active()&&profile(request.auth.uid).role=='customer'&&request.resource.data.customerId==request.auth.uid&&request.resource.data.workerId is string&&request.resource.data.rating is number&&request.resource.data.rating>=1&&request.resource.data.rating<=5&&request.resource.data.bookingId is string;
   allow update,delete:if false;
  }
  match /{document=**}{allow read,write:if false;}
 }
}
// Worker completion submission permission; deployment isolated from Storage.
